{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "marstv-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/v1/*", "/healthz"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "marstv",
      "database_id": "replace-with-d1-database-id",
      "migrations_dir": "../../migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "replace-with-kv-namespace-id"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BACKUPS",
      "bucket_name": "marstv-backups"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PAIRING",
        "class_name": "PairingCoordinator"
      },
      {
        "name": "RATE_LIMITER",
        "class_name": "RateLimiter"
      },
      {
        "name": "SYNC",
        "class_name": "SyncCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PairingCoordinator",
        "RateLimiter",
        "SyncCoordinator"
      ]
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "JOBS",
        "queue": "marstv-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "marstv-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "marstv-jobs-dlq"
      }
    ]
  },
  "triggers": {
    "crons": ["*/15 * * * *", "0 3 * * *"]
  },
  "vars": {
    "MARSTV_PUBLIC_ORIGIN": "http://localhost:4173",
    "MARSTV_DOUBAN_ENABLED": "false",
    "MARSTV_DOUBAN_ORIGIN": "https://movie.douban.com"
  }
}
